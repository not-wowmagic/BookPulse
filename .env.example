BOOKPULSE_ENV=development
BOOKPULSE_MODE=demo

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key

REDIS_URL=redis://localhost:6379
REDIS_REST_URL=
REDIS_REST_TOKEN=

CRON_SECRET=replace-with-long-random-secret-at-least-24-chars

OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_TIMEOUT_MS=3500
OPENLIBRARY_MIN_CALL_INTERVAL_MS=1000
SOURCE_TIMEOUT_MS=5000
SOURCE_RETRY_ATTEMPTS=2
AUTHOR_SIMILARITY_THRESHOLD=85
METADATA_FAILURE_THRESHOLD=3

GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
GOOGLE_BOOKS_API_KEY=

FIRECRAWL_SEARCH_ENDPOINT=https://api.firecrawl.dev/v1/search
FIRECRAWL_SCRAPE_ENDPOINT=https://api.firecrawl.dev/v1/scrape
FIRECRAWL_API_KEY=

SWR_FRESH_SECONDS=21600
SWR_STALE_SECONDS=259200
LOCK_TTL_SECONDS=900

INGEST_REQUIRED_SOURCES=reddit
PHT_TIMEZONE=Asia/Manila
ALLOW_DEMO_SOURCES=true

TIKTOK_TRENDS_ENDPOINT=https://example.com/tiktok/trends
TIKTOK_API_TOKEN=replace-with-token

REDDIT_TRENDS_ENDPOINT=https://oauth.reddit.com/r/phbookclub/new
REDDIT_API_TOKEN=replace-with-oauth-access-token
REDDIT_USER_AGENT=web:bookpulse:1.0 (by /u/your-reddit-account)
REDDIT_COLLECTION_WINDOW_HOURS=24
REDDIT_MAX_PAGES=4

GOODREADS_TRENDS_ENDPOINT=https://example.com/goodreads/trends
GOODREADS_API_TOKEN=replace-with-token

ADMIN_EDIT_TOKEN=replace-with-long-admin-token
